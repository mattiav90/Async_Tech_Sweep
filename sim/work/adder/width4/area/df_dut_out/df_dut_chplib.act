defproc func_01pW4W4W5(chan?(int<4>)in0; chan?(int<4>)in1; chan!(int<5>) out0) {
  int<4> x0;
  int<4> x1;
  int<5> res0; /* out */
  chp {
    *[
      in0?x0, in1?x1;
      log("receive (", x0, ",", x1, ")");
      res0 := x0 + x1;
      out0!res0;
      log("send (", res0, ",", ")")
    ]
  }
}

defproc func_0W5W5(chan?(int<5>)in0; chan!(int<5>) out0) {
