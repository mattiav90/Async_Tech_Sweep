defproc func_0i1ei0i1qW1W1(chan?(int<1>)in0; chan!(int<1>) out0) {
  int<1> x0;
  int<1> res0;
  int<1> res1; /* out */
  chp {
    *[
      in0?x0;
      log("receive (", x0, ")");
      res0 := int(x0 = int(0x1,1));
      res1 := bool(res0) ? int(0x0,1) : int(0x1,1);
      out0!res1;
      log("send (", res1, ",", ")")
    ]
  }
}

defproc func_01pW8W8W9(chan?(int<8>)in0; chan?(int<8>)in1; chan!(int<9>) out0) {
