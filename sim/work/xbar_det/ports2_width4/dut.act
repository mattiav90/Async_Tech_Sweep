import std;
import "harness.act";

import "crossbar.act";

defproc dut (chan?(int<4>) IN[2]; chan?(int<1>) DST[2]; chan?(int<1>) SEL[2]; chan!(int<4>) OUT[2])
{
  xbar_det<4, 2> m(IN, DST, SEL, OUT);
}

defproc tb ()
{
  chan(int<4>) a[2];
  chan(int<1>) ds[2];
  chan(int<1>) sl[2];
  chan(int<4>) o[2];
  dut d;
  (i : 2 : d.IN[i] = a[i];)
  (i : 2 : d.DST[i] = ds[i];)
  (i : 2 : d.SEL[i] = sl[i];)
  (i : 2 : d.OUT[i] = o[i];)
  rand_src<4, 2463534242, 30> sa[2];
  (i : 2 : sa[i].O = a[i];)
  rot_fwd<1, 0, 2, 30> fw0(ds[0]);
  rot_fwd<1, 1, 2, 30> fw1(ds[1]);
  rot_rev<1, 0, 2, 30> rv0(sl[0]);
  rot_rev<1, 1, 2, 30> rv1(sl[1]);
  nsink<4> k[2];
  (i : 2 : o[i] = k[i].I;)
}
