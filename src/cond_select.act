// this is a conditional selection, wrapped around an adder
// ----------------------------------------------------------------------------
// The question: what does a CHP selection
//
//      [ guard -> ...
//      [] else -> ...
//      ]
//
// actually cost in an asynchronous circuit? A selection is not free the way an
// `if` is free in software: the guards have to be evaluated and their
// completion detected before either branch can fire, and that is real hardware
// sitting in the critical path on EVERY token, taken or not.
//
// Measure it with three processes and one control knob:
//
//   plain_adder  no selection at all              -- the baseline
//   cond_adder   selection; CTRL=1 adds, CTRL=0 passes A through
//   skip_adder   no selection, never adds         -- the other baseline
//
// Then drive CTRL three ways (see the `mode` sweep knob in scripts/sweep.py):
//
//   always  CTRL=1 forever  -> cond_adder vs plain_adder
//                              = the OVERHEAD OF THE SELECTION, with the adder
//                                work held constant
//   never   CTRL=0 forever  -> cond_adder vs skip_adder
//                              = the same overhead, with no adder work at all
//   random  CTRL 50/50      -> what a data-dependent branch really costs
//
// and `always` vs `never` on cond_adder alone is the cost of the adder path.
//
// Sweep knobs: width, mode.
// ----------------------------------------------------------------------------

// Baseline: always adds, no selection.
template <pint width> defproc plain_adder(
    chan?(int<width>) A;
    chan?(int<width>) B;
    chan?(int<1>) CTRL;
    chan!(int<width+1>) OUT
    ){
        int<width> a, b;
        int<1> c;
        chp{
        // CTRL is still received, so the handshake count matches cond_adder
        // exactly and the only difference left is the selection itself.
        *[ A?a, B?b, CTRL?c; OUT!a+b ]
        }
}

// Baseline: never adds, no selection.
template <pint width> defproc skip_adder(
    chan?(int<width>) A;
    chan?(int<width>) B;
    chan?(int<1>) CTRL;
    chan!(int<width+1>) OUT
    ){
        int<width> a, b;
        int<1> c;
        chp{
        *[ A?a, B?b, CTRL?c; OUT!a ]
        }
}

// The one under test: same work, but reached through a selection.
template <pint width> defproc cond_adder(
    chan?(int<width>) A;
    chan?(int<width>) B;
    chan?(int<1>) CTRL;
    chan!(int<width+1>) OUT
    ){
        int<width> a, b;
        int<1> c;
        chp{
        *[
            A?a, B?b, CTRL?c;
            [ c = 1 -> OUT!a+b
            [] else -> OUT!a
            ]
        ]
        }
}
