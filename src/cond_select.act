// this is a conditional selection, wrapped around an adder
// ----------------------------------------------------------------------------
// The question: what does a CHP selection
//
//      [ guard -> ...
//      [] else -> ...
//      ]
//
// actually cost in an asynchronous circuit? A selection is not free the way an
// `if` is free in software: the guards have to be evaluated and their
// completion detected before either branch can fire, and that is real hardware
// sitting in the critical path on EVERY token, taken or not.
//
// Measure it with two processes and one control knob:
//
//   plain_adder  no selection at all: always OUT!a+b   -- the baseline
//   cond_adder   [ c=1 -> OUT!a+b [] else -> skip ]
//
// Then drive cond_adder's CTRL three ways (the `mode` knob in scripts/sweep.py):
//
//   always  CTRL=1 forever  -> every token takes the a+b path; vs plain_adder
//                              this is the OVERHEAD OF THE SELECTION itself,
//                              with the adder work held constant
//   never   CTRL=0 forever  -> every token takes the skip path: no output at
//                              all, just the guard evaluation
//   random  CTRL 50/50      -> half the tokens each way: what a data-dependent
//                              branch really costs
//
// Sweep knobs: width, mode.
// ----------------------------------------------------------------------------

// Baseline: always adds, no selection.
template <pint width> defproc plain_adder(
    chan?(int<width>) A;
    chan?(int<width>) B;
    chan?(int<1>) CTRL;
    chan!(int<width+1>) OUT
    ){
        int<width> a, b;
        int<1> c;
        chp{
        // CTRL is still received, so the handshakes match cond_adder(always)
        // exactly and the only difference left is the selection itself.
        *[ A?a, B?b, CTRL?c; OUT!a+b ]
        }
}

// The one under test: same work, but reached through a selection.
template <pint width> defproc cond_adder(
    chan?(int<width>) A;
    chan?(int<width>) B;
    chan?(int<1>) CTRL;
    chan!(int<width+1>) OUT
    ){
        int<width> a, b;
        int<1> c;
        chp{
        *[
            A?a, B?b, CTRL?c;
            [ c = 1 -> OUT!a+b
            [] else -> skip
            ]
        ]
        }
}
